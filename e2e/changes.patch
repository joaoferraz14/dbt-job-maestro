+"""Assert the Airflow DAG-generation matrix produced what each config promised.
+
+Portable across dbt projects: expectations are relative (counts compared between
+variants, structure inspected) rather than hardcoded to one project's selectors.
+
+Reads the rendered configs to find each variant's dags_dir.
+
+Env:
+  MAESTRO_E2E_RENDERED  dir of rendered configs   [$MAESTRO_E2E_WORKDIR/configs]
+  MAESTRO_E2E_WORKDIR   scratch dir
+"""
+
+import os
+import re
+import sys
+
+from dbt_job_maestro.config import Config
+
+WORKDIR = os.environ.get("MAESTRO_E2E_WORKDIR", os.environ.get("MAESTRO_E2E_SCRATCH", ""))
+RENDERED = os.environ.get("MAESTRO_E2E_RENDERED", os.path.join(WORKDIR, "configs"))
+
+results = []
+
+
+def check(label, condition, detail=""):
+    results.append((bool(condition), label, detail))
+    print(f"  [{'PASS' if condition else 'FAIL'}] {label}" + (f"  -- {detail}" if detail else ""))
+
+
+def cfg_of(name):
+    path = os.path.join(RENDERED, f"{name}.yml")
+    return Config.from_yaml(path) if os.path.exists(path) else None
+
+
+def read_all(name):
+    c = cfg_of(name)
+    if not c:
+        return None
+    d = c.airflow.dags_dir
+    if not os.path.isdir(d):
+        return None
+    return {f: open(os.path.join(d, f)).read()
+            for f in sorted(os.listdir(d)) if f.endswith(".py")}
+
+
+def schedules(sources):
+    out = {}
+    for name, src in sources.items():
+        m = re.search(r"^\s+schedule(?:_interval)?=(.+),$", src, re.M)
+        out[name] = m.group(1) if m else None
+    return out
+
+
+def commands(sources):
+    return [m for v in sources.values() for m in re.findall(r'bash_command="([^"]+)"', v)]
+
+
+def cron_minutes(expr):
+    p = expr.strip('"').split()
+    return int(p[1]) * 60 + int(p[0])
+
+
+SIMPLE = read_all("10-af-simple")
+if SIMPLE is None:
+    print(f"no generated DAGs found (rendered configs: {RENDERED}) - "
+          "run e2e/render_configs.sh then e2e/run_dag_matrix.sh first")
+    sys.exit(2)
+
+print("\n=== 10-af-simple: one DAG per selector, runtime flags ===")
+c10 = cfg_of("10-af-simple")
+cmds = commands(SIMPLE)
+check("produced DAG files", len(SIMPLE) > 0, f"{len(SIMPLE)} files")
+check("every file carries the generated marker",
+      all("# Auto-generated by dbt-job-maestro" in v for v in SIMPLE.values()))
+check("every DAG has exactly one dag_id",
+      all(len(re.findall(r'dag_id="', v)) == 1 for v in SIMPLE.values()))
+check("every command passes --project-dir", all("--project-dir " in c for c in cmds))
+check("every command passes --profiles-dir", all("--profiles-dir " in c for c in cmds))
+check(f"every command passes --target {c10.airflow.dbt_target}",
+      all(f"--target {c10.airflow.dbt_target}" in c for c in cmds))
+check(f"every command passes --threads {c10.airflow.dbt_threads}",
+      all(f"--threads {c10.airflow.dbt_threads}" in c for c in cmds))
+check("all schedules are the configured cron",
+      set(schedules(SIMPLE).values()) == {f'"{c10.airflow.schedule_interval}"'},
+      str(set(schedules(SIMPLE).values()))[:70])
+check("seeds selector uses `dbt seed`", any(c.startswith("dbt seed ") for c in cmds))
+check("snapshots selector uses `dbt snapshot`", any(c.startswith("dbt snapshot ") for c in cmds))
+check("model selectors use `dbt build`", any(c.startswith("dbt build ") for c in cmds))
+check("v2 emits schedule_interval kwarg", all("schedule_interval=" in v for v in SIMPLE.values()))
+check("v2 uses the legacy BashOperator import",
+      all("from airflow.operators.bash import BashOperator" in v for v in SIMPLE.values()))
+check("all files are valid Python",
+      all(compile(v, k, "exec") or True for k, v in SIMPLE.items()))
+
+STAG = read_all("11-af-staggered")
+if STAG:
+    print("\n=== 11-af-staggered: offsets, day-of-week, SLA, execution_order ===")
+    c11 = cfg_of("11-af-staggered")
+    sch = schedules(STAG)
+    manual_cron = f'"{c11.airflow.manual_schedule_interval}"'
+    auto_crons = sorted({v for v in sch.values() if v and v != manual_cron})
+    inc, start = c11.airflow.cron_increment_minutes, c11.airflow.start_hour * 60 + c11.airflow.start_minute
+    check("staggered crons are not all identical", len(auto_crons) > 1, f"{len(auto_crons)} distinct")
+    if c11.airflow.cron_days_of_week:
+        day_map = {"SUN": "0", "MON": "1", "TUE": "2", "WED": "3", "THU": "4", "FRI": "5", "SAT": "6"}
+        want = ",".join(day_map[d.upper()] for d in c11.airflow.cron_days_of_week)
+        check(f"crons carry the configured days of week ({want})",
+              all(c.strip('"').endswith(want) for c in auto_crons), auto_crons[:2])
+    mins = sorted(cron_minutes(c) for c in auto_crons)
+    check(f"every staggered cron sits on the {inc}-minute grid from the start time",
+          all((m - start) % inc == 0 for m in mins),
+          f"offenders={[m for m in mins if (m - start) % inc][:3]}")
+    check("no two auto DAGs share a staggered slot", len(mins) == len(set(mins)))
+    if c11.airflow.manual_schedule_interval:
+        check("manual selectors use manual_schedule_interval", manual_cron in sch.values())
+        mf = [k for k, v in sch.items() if v == manual_cron]
+        if c11.airflow.manual_sla_minutes > 0:
+            check(f"manual DAGs get manual_sla_minutes={c11.airflow.manual_sla_minutes}",
+                  all(f'"sla": timedelta(minutes={c11.airflow.manual_sla_minutes})' in STAG[k]
+                      for k in mf), f"{len(mf)} manual DAGs")
+        af = [k for k, v in sch.items() if v != manual_cron]
+        if c11.airflow.sla_minutes > 0:
+            check(f"auto DAGs get sla_minutes={c11.airflow.sla_minutes}",
+                  all(f'"sla": timedelta(minutes={c11.airflow.sla_minutes})' in STAG[k] for k in af))
+    if c11.airflow.execution_order[:1] == ["seeds"]:
+        seed_dags = [k for k in STAG if k.endswith("_seeds.py")]
+        model_dags = [k for k, v in sch.items()
+                      if v != manual_cron and k not in seed_dags
+                      and not k.endswith("_snapshots.py")]
+        if seed_dags and model_dags:
+            check("execution_order schedules seeds before models",
+                  max(cron_minutes(sch[k]) for k in seed_dags)
+                  < max(cron_minutes(sch[k]) for k in model_dags))
+
+NONE = read_all("12-af-none")
+if NONE:
+    print("\n=== 12-af-none: no schedule ===")
+    check("every DAG has schedule_interval=None", set(schedules(NONE).values()) == {"None"})
+    check("no SLA emitted when sla_minutes=0", not any('"sla"' in v for v in NONE.values()))
+
+FF, CO = read_all("13-af-combined-failfast"), read_all("14-af-combined-continue")
+if FF and CO:
+    print("\n=== 13/14: combined small selectors, fail-fast vs continue ===")
+    cname = next((f for f in FF if f.endswith("combined_small_selectors.py")), None)
+    check("13 produced a combined DAG", cname is not None)
+    check("14 produced a combined DAG",
+          any(f.endswith("combined_small_selectors.py") for f in CO))
+    check("combining reduced the DAG count vs one-per-selector",
+          len(FF) < len(SIMPLE), f"{len(FF)} vs {len(SIMPLE)}")
+    if cname:
+        d13, d14 = (re.findall(r"^\s+(\w+) >> (\w+)$", FF[cname], re.M),
+                    re.findall(r"^\s+(\w+) >> (\w+)$", CO[cname], re.M))
+        t13, t14 = (re.findall(r'task_id="([^"]+)"', FF[cname]),
+                    re.findall(r'task_id="([^"]+)"', CO[cname]))
+        check("fail-fast chains task groups with >>", len(d13) > 0, f"{len(d13)} chain links")
+        check("continue_on_failure leaves groups independent (no >>)", len(d14) == 0,
+              f"{len(d14)} chain links")
+        check("both combined DAGs contain the same tasks", t13 == t14,
+              f"{len(t13)} vs {len(t14)}")
+    check("seeds/snapshots are never combined",
+          any(f.endswith("_seeds.py") for f in FF)
+          and any(f.endswith("_snapshots.py") for f in FF))
+
+CMD = read_all("15-af-commands")
+if CMD:
+    print("\n=== 15-af-commands: run_test + per-selector overrides ===")
+    c15 = cfg_of("15-af-commands")
+    prefix = c15.airflow.selector_prefix + "_"
+    auto_files = {k: v for k, v in CMD.items()
+                  if not k.endswith(("_seeds.py", "_snapshots.py"))
+                  and re.search(r'dag_id="[^"]*' + re.escape(prefix), v)}
+    check("default_command=run_test emits two tasks on auto selectors",
+          any(len(re.findall(r'task_id="', v)) == 2 for v in auto_files.values()))
+    check("run_test wires run >> test",
+          any(re.search(r"run_\w+ >> test_\w+", v) for v in auto_files.values()))
+    check("auto selectors use `dbt run` (the run half of run_test)",
+          any("dbt run --selector" in v for v in auto_files.values()))
+    check("auto selectors IGNORE selector_commands overrides",
+          all("dbt build --selector" not in v for v in auto_files.values()),
+          "auto must use default_command uniformly")
+    seeds = next((v for k, v in CMD.items() if k.endswith("_seeds.py")), "")
+    snaps = next((v for k, v in CMD.items() if k.endswith("_snapshots.py")), "")
+    check("seeds keep `dbt seed` despite default_command=run_test",
+          "dbt seed --selector" in seeds and "dbt run " not in seeds)
+    check("snapshots keep `dbt snapshot` despite default_command=run_test",
+          "dbt snapshot --selector" in snaps)
+
+FR = read_all("16-af-fullrefresh")
+if FR:
+    print("\n=== 16-af-fullrefresh: auto + custom shapes + seeds ===")
+    c16 = cfg_of("16-af-fullrefresh")
+    pre = c16.airflow.dag_id_prefix
+    sch = schedules(FR)
+    check("extra full-refresh DAGs beyond the per-selector set",
+          len(FR) > len(SIMPLE), f"{len(FR)} vs {len(SIMPLE)}")
+    if c16.airflow.full_refresh.enabled:
+        f = f"{pre}_full_refresh_incremental.py"
+        check(f"{f} exists", f in FR)
+        if f in FR:
+            check("auto full-refresh uses build --full-refresh --selector",
+                  "dbt build --full-refresh --selector" in FR[f])
+            check("auto full-refresh has its own cron",
+                  sch.get(f) == f'"{c16.airflow.full_refresh.cron_schedule}"')
+    shape_expect = {"selector": "--full-refresh --selector", "tags": "--full-refresh --select tag:",
+                    "paths": "--full-refresh --select path:", "models": "--full-refresh --select "}
+    for sched in c16.airflow.full_refresh.custom_schedules:
+        f = f"{pre}_full_refresh_{sched.name}.py"
+        check(f"{f} exists", f in FR)
+        if f in FR:
+            kind = ("selector" if sched.selector else "tags" if sched.tags
+                    else "paths" if sched.paths else "models")
+            check(f"{f}: command matches its {kind} shape", shape_expect[kind] in FR[f])
+            check(f"{f}: own cron {sched.cron_schedule}",
+                  sch.get(f) == f'"{sched.cron_schedule}"')
+    if c16.airflow.seeds_full_refresh.enabled:
+        f = f"{pre}_seeds_full_refresh.py"
+        check(f"{f} exists", f in FR)
+        if f in FR:
+            check("seeds full-refresh uses seed --full-refresh",
+                  "dbt seed --full-refresh --selector" in FR[f])
+
+LEG = read_all("17-af-legacy")
+if LEG:
+    print("\n=== 17-af-legacy: back-compat normalization ===")
+    c17 = cfg_of("17-af-legacy")
+    check("legacy orchestration_mode normalized to 'simple'",
+          c17.airflow.orchestration_mode == "simple", c17.airflow.orchestration_mode)
+    check("legacy mode still produces scheduled DAGs",
+          set(schedules(LEG).values()) == {f'"{c17.airflow.schedule_interval}"'})
+
+V3 = read_all("18-af-v3")
+if V3:
+    print("\n=== 18-af-v3: Airflow 3 targeting ===")
+    c18 = cfg_of("18-af-v3")
+    check("config requests airflow_version 3", c18.airflow.airflow_version == 3)
+    check("v3 uses schedule= not schedule_interval=",
+          all("schedule_interval=" not in v for v in V3.values())
+          and all(re.search(r"^\s+schedule=", v, re.M) for v in V3.values()))
+    check("v3 uses the provider BashOperator import",
+          all("from airflow.providers.standard.operators.bash import BashOperator" in v
+              for v in V3.values()))
+    check("v3 omits sla (removed in Airflow 3.0)",
+          not any('"sla"' in v for v in V3.values()),
+          f"sla_minutes={c18.airflow.sla_minutes}")
+
+print("\n=== selector names that are not valid Python identifiers ===")
+odd = {k: v for k, v in SIMPLE.items()
+       if not re.sub(r"\.py$", "", k).replace("-", "_").replace(".", "_").isidentifier()
+       or "-" in k or "." in k[:-3]}
+if odd:
+    for k, v in list(odd.items())[:5]:
+        assigns = re.findall(r"^\s+(\S+) = BashOperator\($", v, re.M)
+        check(f"{k}: python variable names are valid identifiers",
+              all(a.isidentifier() for a in assigns), str(assigns[:2]))
+else:
+    print("  (none in this project - nothing to check)")
+
+failed = [r for r in results if not r[0]]
+print(f"\n{'='*70}\nRESULT: {len(results)-len(failed)}/{len(results)} assertions passed")
+if failed:
+    print("FAILED:")
+    for _, label, detail in failed:
+        print(f"  - {label}  {detail}")
+sys.exit(1 if failed else 0)
diff --git a/e2e/assert_idempotency.py b/e2e/assert_idempotency.py
new file mode 100644
index 0000000..5fa48ba
--- /dev/null
+++ b/e2e/assert_idempotency.py
@@ -0,0 +1,103 @@
+"""Prove DAG regeneration is idempotent and safe (WS3).
+
+Seeds a dags dir with three kinds of pre-existing file and regenerates:
+  a) a stale auto-generated DAG no longer backed by any selector -> deleted
+  b) a legacy single-DAG file from an older maestro -> deleted
+  c) a hand-written DAG -> left completely untouched
+Then regenerates twice more to confirm byte-stable output.
+"""
+
+import os
+import shutil
+import sys
+import tempfile
+
+import yaml
+
+from dbt_job_maestro.config import Config
+from dbt_job_maestro.airflow_dag_generator import AirflowDAGGenerator
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+SCRATCH = os.environ["MAESTRO_E2E_SCRATCH"]
+results = []
+
+
+def check(label, condition, detail=""):
+    results.append((bool(condition), label, detail))
+    print(f"  [{'PASS' if condition else 'FAIL'}] {label}" + (f"  -- {detail}" if detail else ""))
+
+
+cfg = Config.from_yaml(os.path.join(REPO, "e2e", "configs", "12-af-none.yml"))
+selectors = yaml.safe_load(
+    open(os.path.join(REPO, "e2e", "artifacts", "selectors_02-special.yml"))
+)["selectors"]
+
+workdir = tempfile.mkdtemp(prefix="maestro-idem-", dir=os.path.join(SCRATCH, "dags"))
+gen = AirflowDAGGenerator(cfg.airflow)
+
+STALE = "dbt_maestro_a_selector_that_no_longer_exists.py"
+LEGACY = "dbt_maestro_dag.py"
+HANDWRITTEN = "my_own_pipeline.py"
+HAND_BODY = (
+    '"""My hand-written DAG. Maestro must never touch this."""\n'
+    "from airflow import DAG\n"
+    "# no maestro marker anywhere in here\n"
+    "SENTINEL = 'do-not-delete'\n"
+)
+
+with open(os.path.join(workdir, STALE), "w") as f:
+    f.write("# Auto-generated by dbt-job-maestro - DO NOT EDIT\n# stale\n")
+with open(os.path.join(workdir, LEGACY), "w") as f:
+    f.write('"""\nAuto-generated by dbt-job-maestro.\n"""\n# legacy single-DAG layout\n')
+with open(os.path.join(workdir, HANDWRITTEN), "w") as f:
+    f.write(HAND_BODY)
+
+print("\n=== first regeneration over a dirty dags dir ===")
+dags = gen.generate_dags(selectors)
+written, removed = gen.write_dags(dags, workdir)
+check("stale auto-generated DAG was removed", STALE in removed, f"removed={len(removed)}")
+check("legacy dbt_maestro_dag.py was removed", LEGACY in removed)
+check("hand-written DAG was NOT removed", HANDWRITTEN not in removed)
+check("hand-written DAG content is byte-identical",
+      open(os.path.join(workdir, HANDWRITTEN)).read() == HAND_BODY)
+check("hand-written DAG still on disk", os.path.exists(os.path.join(workdir, HANDWRITTEN)))
+check("wrote one file per generated DAG", len(written) == len(dags), f"{len(written)}/{len(dags)}")
+
+on_disk = {f for f in os.listdir(workdir) if f.endswith(".py")}
+check("dags dir now holds exactly the generated set plus the hand-written file",
+      on_disk == set(dags) | {HANDWRITTEN},
+      f"unexpected={sorted(on_disk - set(dags) - {HANDWRITTEN})[:3]}")
+
+print("\n=== repeat regeneration is byte-stable ===")
+snapshot = {f: open(os.path.join(workdir, f)).read() for f in on_disk}
+for run in (2, 3):
+    dags2 = gen.generate_dags(selectors)
+    written2, removed2 = gen.write_dags(dags2, workdir)
+    after = {f: open(os.path.join(workdir, f)).read()
+             for f in os.listdir(workdir) if f.endswith(".py")}
+    check(f"run {run}: nothing removed", not removed2, f"removed={removed2[:3]}")
+    check(f"run {run}: output byte-identical to run 1", after == snapshot,
+          f"changed={[k for k in after if snapshot.get(k) != after[k]][:3]}")
+
+print("\n=== changing the selector set removes only the orphaned DAGs ===")
+subset = [s for s in selectors if s["name"] in {"maestro_seeds", "maestro_snapshots"}]
+dags3 = gen.generate_dags(subset)
+written3, removed3 = gen.write_dags(dags3, workdir)
+check("regenerating with 2 selectors removes the rest",
+      len(removed3) == len(snapshot) - len(dags3) - 1,
+      f"removed={len(removed3)} was={len(snapshot)} now={len(dags3)}")
+check("hand-written DAG survived the purge",
+      os.path.exists(os.path.join(workdir, HANDWRITTEN))
+      and open(os.path.join(workdir, HANDWRITTEN)).read() == HAND_BODY)
+check("only the 2 generated DAGs plus hand-written remain",
+      {f for f in os.listdir(workdir) if f.endswith(".py")} == set(dags3) | {HANDWRITTEN})
+
+shutil.rmtree(workdir, ignore_errors=True)
+
+failed = [r for r in results if not r[0]]
+print(f"\n{'='*70}\nIDEMPOTENCY RESULT: {len(results)-len(failed)}/{len(results)} assertions passed")
+if failed:
+    print("FAILED:")
+    for _, label, detail in failed:
+        print(f"  - {label}  {detail}")
+sys.exit(1 if failed else 0)
diff --git a/e2e/assert_selectors.py b/e2e/assert_selectors.py
new file mode 100644
index 0000000..7b21442
--- /dev/null
+++ b/e2e/assert_selectors.py
@@ -0,0 +1,280 @@
+"""Assert the selector-generation matrix produced what each config promised.
+
+Portable across dbt projects: every expectation is derived from the artifacts and
+the baseline selectors file rather than hardcoded counts, so this works on any
+project rather than the one it was first written against.
+
+Reads the files written by run_selector_matrix.sh into $MAESTRO_E2E_ARTIFACTS.
+
+Env:
+  MAESTRO_E2E_ARTIFACTS   dir holding selectors_<label>.yml   [e2e/artifacts]
+  BASELINE_SELECTORS      the project's original selectors.yml (optional; when
+                          set, manual-selector preservation is checked against it)
+  MAESTRO_E2E_MANIFEST    manifest.json (optional; enables model-count checks)
+"""
+
+import json
+import os
+import sys
+
+import yaml
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+ART = os.environ.get("MAESTRO_E2E_ARTIFACTS", os.path.join(REPO, "e2e", "artifacts"))
+BASELINE = os.environ.get("BASELINE_SELECTORS", "")
+MANIFEST = os.environ.get("MAESTRO_E2E_MANIFEST", "")
+
+results = []
+
+
+def check(label, condition, detail=""):
+    results.append((bool(condition), label, detail))
+    print(f"  [{'PASS' if condition else 'FAIL'}] {label}" + (f"  -- {detail}" if detail else ""))
+
+
+def load(label):
+    path = os.path.join(ART, f"selectors_{label}.yml")
+    if not os.path.exists(path):
+        return None
+    with open(path) as f:
+        return (yaml.safe_load(f) or {}).get("selectors", []) or []
+
+
+def names(sels):
+    return [s["name"] for s in sels]
+
+
+def by_name(sels, name):
+    return next((s for s in sels if s["name"] == name), None)
+
+
+def methods_of(sel):
+    """Method dicts inside a selector's positive (union/intersection) clauses."""
+    found = []
+
+    def walk(node):
+        if isinstance(node, dict):
+            if "method" in node:
+                found.append(node)
+            for key in ("union", "intersection"):
+                for item in node.get(key, []) or []:
+                    walk(item)
+        elif isinstance(node, list):
+            for item in node:
+                walk(item)
+
+    walk(sel.get("definition", {}))
+    return found
+
+
+def pairs_of(sel):
+    return [(m.get("method"), m.get("value")) for m in methods_of(sel)]
+
+
+def exclude_values(sel):
+    found = []
+
+    def walk(node):
+        if isinstance(node, dict):
+            if "exclude" in node:
+                found.append(node["exclude"])
+            for key in ("union", "intersection"):
+                for item in node.get(key, []) or []:
+                    walk(item)
+        elif isinstance(node, list):
+            for item in node:
+                walk(item)
+
+    walk(sel.get("definition", {}))
+    return found
+
+
+def exclude_shapes(sels):
+    """dbt requires a list under `exclude`. Classify what was emitted."""
+    shapes = set()
+    for sel in sels:
+        for value in exclude_values(sel):
+            if isinstance(value, dict):
+                shapes.add("dict")
+            elif isinstance(value, list):
+                if any(isinstance(v, dict) and "intersection" in v for v in value):
+                    shapes.add("nested-int")
+                else:
+                    shapes.add("flat-list")
+    return shapes
+
+
+def auto(sels, prefix="maestro_"):
+    return [s for s in sels if s["name"].startswith(prefix)]
+
+
+def manual(sels, prefix="maestro_"):
+    return [
+        s for s in sels
+        if not s["name"].startswith(prefix) and not s["name"].startswith("freshness_")
+    ]
+
+
+BASELINE_NAMES = set()
+MANUAL_NAMES = set()
+if BASELINE and os.path.exists(BASELINE):
+    BASELINE_NAMES = set(names((yaml.safe_load(open(BASELINE)) or {}).get("selectors", []) or []))
+    # A baseline captured from a project that already ran maestro contains
+    # auto-generated names too. Those are legitimately dropped when a config does
+    # not generate them, so only genuinely hand-written selectors are expected to
+    # survive every run.
+    MANUAL_NAMES = {
+        n for n in BASELINE_NAMES
+        if not n.startswith("maestro_") and not n.startswith("freshness_")
+    }
+
+MODEL_NAMES = set()
+if MANIFEST and os.path.exists(MANIFEST):
+    _m = json.load(open(MANIFEST))
+    MODEL_NAMES = {
+        v["name"] for v in _m.get("nodes", {}).values() if v.get("resource_type") == "model"
+    }
+
+BASE = load("01-baseline")
+if BASE is None:
+    print("no artifacts found - run e2e/run_selector_matrix.sh first")
+    sys.exit(2)
+
+print("\n=== 01-baseline: defaults, manual preservation ===")
+check("produced selectors", len(BASE) > 0, f"{len(BASE)} selectors")
+check("auto-generated selectors exist", len(auto(BASE)) > 0, f"{len(auto(BASE))} auto")
+check("no duplicate selector names", len(names(BASE)) == len(set(names(BASE))))
+check("every auto selector has a definition", all(s.get("definition") for s in auto(BASE)))
+check("every auto selector selects something",
+      all(methods_of(s) for s in auto(BASE)),
+      f"{sum(1 for s in auto(BASE) if not methods_of(s))} empty")
+if MANUAL_NAMES:
+    check("all baseline manual selectors preserved", MANUAL_NAMES <= set(names(BASE)),
+          f"missing={sorted(MANUAL_NAMES - set(names(BASE)))[:3]}")
+if MODEL_NAMES:
+    referenced = {v for s in auto(BASE) for m, v in pairs_of(s) if m == "fqn"}
+    check("auto selectors reference only real models",
+          referenced <= MODEL_NAMES | {"*"},
+          f"unknown={sorted(referenced - MODEL_NAMES - {'*'})[:3]}")
+
+SPECIAL = load("02-special")
+if SPECIAL:
+    print("\n=== 02-special: seeds / snapshots / full-refresh / orphans ===")
+    seeds = by_name(SPECIAL, "maestro_seeds")
+    snaps = by_name(SPECIAL, "maestro_snapshots")
+    fr = by_name(SPECIAL, "maestro_full_refresh_incremental")
+    orph = by_name(SPECIAL, "maestro_orphan_models")
+    check("maestro_seeds exists", seeds is not None)
+    check("maestro_seeds selects by path", seeds and any(m == "path" for m, _ in pairs_of(seeds)))
+    check("maestro_snapshots exists", snaps is not None)
+    check("maestro_snapshots selects by path", snaps and any(m == "path" for m, _ in pairs_of(snaps)))
+    check("maestro_full_refresh_incremental exists", fr is not None)
+    check("full-refresh intersects fqn:* with config.materialized:incremental",
+          fr and ("fqn", "*") in pairs_of(fr)
+          and ("config.materialized", "incremental") in pairs_of(fr))
+    check("maestro_orphan_models exists (combine_single_model_selectors)", orph is not None)
+    if orph:
+        n = len([1 for m, _ in pairs_of(orph) if m == "fqn"])
+        check("orphan selector bundles more than one model", n > 1, f"{n} fqn entries")
+    check("combining orphans yields fewer selectors than the baseline",
+          len(SPECIAL) < len(BASE), f"{len(SPECIAL)} vs baseline {len(BASE)}")
+
+FQN = load("03-special-fqn")
+if FQN:
+    print("\n=== 03-special-fqn: seeds/snapshots via fqn method ===")
+    s3 = by_name(FQN, "maestro_seeds")
+    n3 = by_name(FQN, "maestro_snapshots")
+    check("seeds selector uses fqn entries, not path",
+          s3 and pairs_of(s3) and all(m == "fqn" for m, _ in pairs_of(s3)))
+    check("snapshots selector uses fqn entries, not path",
+          n3 and pairs_of(n3) and all(m == "fqn" for m, _ in pairs_of(n3)))
+    check("exactly one combined seeds selector",
+          len([x for x in names(FQN) if x == "maestro_seeds"]) == 1)
+
+EX_U, EX_I = load("04-exclusions"), load("05-exclusions-intersection")
+if EX_U and EX_I:
+    print("\n=== 04 vs 05: exclusion_mode union vs intersection ===")
+    su, si = exclude_shapes(auto(EX_U)), exclude_shapes(auto(EX_I))
+    check("exclusions were emitted at all", su or si, f"union={su} intersection={si}")
+    check("union mode emits a flat exclude list", su == {"flat-list"}, f"shapes={su}")
+    check("intersection mode nests criteria under one intersection entry",
+          si == {"nested-int"}, f"shapes={si}")
+    check("no exclude block is a dict (dbt requires a list)", "dict" not in su | si)
+
+PFX = load("06-prefix-format")
+if PFX:
+    print("\n=== 06-prefix-format: custom prefix, raw manual, indirect_selection ===")
+    orch = [n for n in names(PFX) if n.startswith("orch_")]
+    check("auto selectors use the custom prefix orch_", len(orch) > 0, f"{len(orch)} orch_")
+    # Under a custom prefix, any pre-existing maestro_* selector is a MANUAL
+    # selector and must be preserved - so the only maestro_* names allowed are
+    # ones that were already in the baseline.
+    leaked = [n for n in names(PFX) if n.startswith("maestro_") and n not in BASELINE_NAMES]
+    check("no NEW default-prefix selectors were generated under a custom prefix",
+          not leaked, f"leaked={leaked[:3]}")
+    auto_pfx = auto(PFX, "orch_")
+    with_is = [s for s in auto_pfx
+               if methods_of(s) and all(m.get("indirect_selection") == "cautious"
+                                        for m in methods_of(s))]
+    check("indirect_selection set on every method of every auto selector",
+          auto_pfx and len(with_is) == len(auto_pfx), f"{len(with_is)}/{len(auto_pfx)}")
+    check("indirect_selection NOT injected into manual selectors",
+          not [s for s in manual(PFX, "orch_")
+               if any("indirect_selection" in m for m in methods_of(s))])
+    check("indirect_selection never emitted as a root-level 'default' dict "
+          "(dbt rejects the whole file)",
+          not [s["name"] for s in PFX if isinstance(s.get("default"), dict)])
+    if MANUAL_NAMES:
+        raw = open(os.path.join(ART, "selectors_06-prefix-format.yml")).read()
+        sample = sorted(MANUAL_NAMES)[:5]
+        check("reformat_manual_selectors=false keeps manual text verbatim",
+              all(f"- name: {n}\n" in raw for n in sample), f"checked {sample}")
+
+NOFRESH, ALLFRESH, WLFRESH = (load("07-freshness-removal"), load("08-freshness-all"),
+                              load("09-freshness-whitelist"))
+if NOFRESH:
+    print("\n=== 07 / 08 / 09: freshness lifecycle ===")
+    check("07 removes all auto freshness selectors",
+          not [n for n in names(NOFRESH) if n.startswith("freshness_")])
+if ALLFRESH:
+    f8 = [n for n in names(ALLFRESH) if n.startswith("freshness_")]
+    a8 = auto(ALLFRESH)
+    check("08 empty whitelist gives every auto selector a freshness variant",
+          len(f8) == len(a8), f"freshness={len(f8)} auto={len(a8)}")
+    check("08 freshness names mirror their base selector",
+          all(n[len("freshness_"):] in set(names(ALLFRESH)) for n in f8[:20]))
+if WLFRESH:
+    f9 = sorted(n for n in names(WLFRESH) if n.startswith("freshness_"))
+    check("09 whitelist minus blacklist yields fewer than 'all'",
+          not ALLFRESH or len(f9) < len([n for n in names(ALLFRESH)
+                                        if n.startswith("freshness_")]),
+          f"{len(f9)} freshness selectors: {f9[:3]}")
+    if f9:
+        fsel = by_name(WLFRESH, f9[0])
+        base_name = f9[0][len("freshness_"):]
+        check("freshness definition intersects its selector with source_status:fresher",
+              fsel and ("source_status", "fresher") in pairs_of(fsel)
+              and ("selector", base_name) in pairs_of(fsel))
+
+print("\n=== cross-config invariants ===")
+for label in ["01-baseline", "02-special", "03-special-fqn", "04-exclusions",
+              "05-exclusions-intersection", "06-prefix-format", "07-freshness-removal",
+              "08-freshness-all", "09-freshness-whitelist"]:
+    sels = load(label)
+    if not sels:
+        continue
+    dupes = [n for n in set(names(sels)) if names(sels).count(n) > 1]
+    check(f"{label}: unique selector names", not dupes, f"dupes={dupes[:3]}")
+    check(f"{label}: no exclude block is a dict", "dict" not in exclude_shapes(sels))
+    if MANUAL_NAMES and label != "06-prefix-format":
+        check(f"{label}: baseline manual selectors preserved",
+              MANUAL_NAMES <= set(names(sels)),
+              f"missing={sorted(MANUAL_NAMES - set(names(sels)))[:3]}")
+
+failed = [r for r in results if not r[0]]
+print(f"\n{'='*70}\nRESULT: {len(results)-len(failed)}/{len(results)} assertions passed")
+if failed:
+    print("FAILED:")
+    for _, label, detail in failed:
+        print(f"  - {label}  {detail}")
+sys.exit(1 if failed else 0)
